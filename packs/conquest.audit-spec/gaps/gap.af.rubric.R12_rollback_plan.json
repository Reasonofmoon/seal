{
  "id": "gap.af.rubric.R12_rollback_plan",
  "ask": "[AF conquest R12 rollback_plan] Is there a rollback or kill-switch plan appropriate to stage (or justified n/a)?",
  "risk": "product_foundation",
  "schema": {
    "type": "object",
    "required": [
      "evidence_refs",
      "assertion"
    ],
    "properties": {
      "evidence_refs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "assertion": {
        "type": "string",
        "minLength": 12
      },
      "known_issues": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "requires": [
    "gap.af.spec.corpus"
  ],
  "fillers": [
    "human",
    "generative.af.spec-audit-row",
    "import"
  ],
  "af_legacy": {
    "rubric_id": "R12",
    "category": "rollback_plan",
    "measures": "failure/rollback considered"
  },
  "accept": [
    {
      "id": "passes_category",
      "type": "noul",
      "instructions": {
        "question": "Is there a rollback or kill-switch plan appropriate to stage (or justified n/a)?",
        "focus": "Category R12 (rollback_plan). Fail if detection patterns fire.",
        "compare": [
          "`facts.spec_text`",
          "`proposal.value`",
          "`facts.known_cli_flags`"
        ],
        "fail_examples": [
          "prod migrate with no rollback"
        ]
      },
      "criteria": {
        "true": {
          "what": "Spec satisfies rollback_plan",
          "examples": [
            "Clear evidence for failure/rollback considered"
          ]
        },
        "false": {
          "what": "Spec fails rollback_plan",
          "examples": [
            "prod migrate with no rollback"
          ]
        }
      },
      "noul_gte": 0.72
    },
    {
      "id": "evidence_grounded",
      "type": "noul",
      "instructions": {
        "question": "Do `proposal.value.evidence_refs` quote or point to real passages that exist in `facts.spec_text`?",
        "compare": [
          "`proposal.value.evidence_refs`",
          "`facts.spec_text`"
        ]
      },
      "noul_gte": 0.7
    }
  ]
}
