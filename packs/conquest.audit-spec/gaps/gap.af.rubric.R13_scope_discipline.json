{
  "id": "gap.af.rubric.R13_scope_discipline",
  "ask": "[AF conquest R13 scope_discipline] Is the spec free of copy-pasted unrelated project sections and undisciplined scope creep?",
  "risk": "user_trust",
  "schema": {
    "type": "object",
    "required": [
      "evidence_refs",
      "assertion"
    ],
    "properties": {
      "evidence_refs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "assertion": {
        "type": "string",
        "minLength": 12
      },
      "known_issues": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "requires": [
    "gap.af.spec.corpus"
  ],
  "fillers": [
    "human",
    "generative.af.spec-audit-row",
    "import"
  ],
  "af_legacy": {
    "rubric_id": "R13",
    "category": "scope_discipline",
    "measures": "no pasted foreign sections / scope creep"
  },
  "accept": [
    {
      "id": "passes_category",
      "type": "noul",
      "instructions": {
        "question": "Is the spec free of copy-pasted unrelated project sections and undisciplined scope creep?",
        "focus": "Category R13 (scope_discipline). Fail if detection patterns fire.",
        "compare": [
          "`facts.spec_text`",
          "`proposal.value`",
          "`facts.known_cli_flags`"
        ],
        "fail_examples": [
          "F23 secret-scan pasted from another repo",
          "random parallel tracks"
        ]
      },
      "criteria": {
        "true": {
          "what": "Spec satisfies scope_discipline",
          "examples": [
            "Clear evidence for no pasted foreign sections / scope creep"
          ]
        },
        "false": {
          "what": "Spec fails scope_discipline",
          "examples": [
            "F23 secret-scan pasted from another repo",
            "random parallel tracks"
          ]
        }
      },
      "noul_gte": 0.78
    },
    {
      "id": "evidence_grounded",
      "type": "noul",
      "instructions": {
        "question": "Do `proposal.value.evidence_refs` quote or point to real passages that exist in `facts.spec_text`?",
        "compare": [
          "`proposal.value.evidence_refs`",
          "`facts.spec_text`"
        ]
      },
      "noul_gte": 0.7
    }
  ]
}
